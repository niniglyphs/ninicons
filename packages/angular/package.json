{
  "name": "@ninicons/angular",
  "version": "1.0.0",
  "description": "Ninicons for Angular: a standalone <nini-icon> component and 3,000+ icons in seven styles",
  "license": "MIT",
  "author": "Sayantan Roy",
  "homepage": "https://niniglyphs.com/use/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niniglyphs/ninicons.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "icons",
    "svg",
    "angular",
    "ninicons",
    "nini",
    "icon-set"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@angular/core": ">=17"
  },
  "module": "fesm2022/ninicons-angular.mjs",
