  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/ninicons-angular.d.ts",
      "default": "./fesm2022/ninicons-angular.mjs"
    }
  },
  "type": "module",
  "dependencies": {
    "tslib": "^2.3.0"
  }
