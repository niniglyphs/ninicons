{
  "name": "@ninicons/font",
  "version": "1.0.1",
  "description": "Ninicons as an icon font: 3,000+ icons in seven styles, one stylesheet, <i class=\"nini nini-rocket\">",
  "license": "MIT",
  "author": "Sayantan Roy",
  "homepage": "https://niniglyphs.com/use/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niniglyphs/ninicons.git",
    "directory": "packages/font"
  },
  "keywords": [
    "icons",
    "icon-font",
    "webfont",
    "woff2",
    "css",
    "ninicons",
    "nini",
    "icon-set"
  ],
  "files": [
    "dist"
  ],
  "style": "./dist/nini.css",
  "exports": {
    ".": "./dist/nini.css",
    "./nini.css": "./dist/nini.css",
    "./*.css": "./dist/*.css",
    "./fonts/*": "./dist/fonts/*",
    "./codepoints.json": "./dist/codepoints.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ]
}
