{
  "name": "@ninicons/react",
  "version": "1.0.0",
  "description": "Ninicons as React components: 3,000+ icons in seven styles, one weight prop",
  "license": "MIT",
  "author": "Sayantan Roy",
  "homepage": "https://niniglyphs.com/use/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niniglyphs/ninicons.git",
    "directory": "packages/react"
  },
  "keywords": [
    "icons",
    "svg",
    "react",
    "nextjs",
    "ninicons",
    "nini",
    "icon-set"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  }
}
